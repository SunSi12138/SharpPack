diff --git a/src/SharpLink.Generator/RpcGenerator.SharpPackSharedProbe.cs b/src/SharpLink.Generator/RpcGenerator.SharpPackSharedProbe.cs
new file mode 100644
index 0000000..9aa0470
--- /dev/null
+++ b/src/SharpLink.Generator/RpcGenerator.SharpPackSharedProbe.cs
@@ -0,0 +1,150 @@
+using SharpPack.Generator;
+using System.Runtime.CompilerServices;
+
+namespace SharpLink.Generator;
+
+internal readonly record struct SharpPackIntegrationDiagnosticModel(string TypeName, string Detail, Location? Location);
+
+internal sealed record SharpPackIntegrationAnalysisResult(
+    string? ProviderSource, ImmutableArray<SharpPackIntegrationDiagnosticModel> Diagnostics, bool HasBindings)
+{
+    internal static SharpPackIntegrationAnalysisResult Empty { get; } = new(null, [], false);
+}
+
+public partial class RpcGenerator
+{
+    private const string SharpPackAdapterId = "sharplink.serializer.sharppack/v1";
+    private const string SharpPackAdapterTypeName = "global::SharpLink.Serializer.SharpPack.SharpPackRpcCodecAdapter";
+    private const string SharedProvider = "SharpLinkRoutedFormatters";
+
+    private static bool IsSharpPackAdapter(GeneratedCodecModel model)
+        => model.Kind == GeneratedCodecKind.Adapter && model.AdapterId == SharpPackAdapterId &&
+           model.AdapterType == SharpPackAdapterTypeName;
+
+    private static bool IsSharpPackAdapterPlan(FinalAdapterCodecPlan plan)
+        => plan.AdapterId == SharpPackAdapterId && plan.AdapterTypeName == SharpPackAdapterTypeName;
+
+    private static SharpPackIntegrationAnalysisResult AnalyzeSharpPackIntegration(
+        Compilation compilation, CancellationToken cancellationToken)
+    {
+        if (compilation.GetTypeByMetadataName("SharpPack.SharpPackFormatter`1") is null ||
+            compilation.GetTypeByMetadataName("SharpLink.Serializer.SharpPack.SharpPackRpcCodecAdapter") is null)
+            return SharpPackIntegrationAnalysisResult.Empty;
+        return AnalyzeRoutedSharpPackIntegration(compilation, cancellationToken);
+    }
+
+    // Keep the optional analyzer dependency out of the SDK-only path, even at JIT time.
+    [MethodImpl(MethodImplOptions.NoInlining)]
+    private static SharpPackIntegrationAnalysisResult AnalyzeRoutedSharpPackIntegration(
+        Compilation compilation, CancellationToken cancellationToken)
+    {
+        var roots = new Dictionary<string, SharpPackSidecarRoot>(StringComparer.Ordinal);
+        var diagnostics = ImmutableArray.CreateBuilder<SharpPackIntegrationDiagnosticModel>();
+        AddRoots(contractMode: false);
+        AddRoots(contractMode: true);
+        if (roots.Count == 0 && diagnostics.Count == 0) return SharpPackIntegrationAnalysisResult.Empty;
+
+        var plan = SharpPackSidecarGenerator.Generate(compilation, roots.OrderBy(static entry => entry.Key, StringComparer.Ordinal)
+            .Select(static entry => entry.Value).ToImmutableArray(), SharedProvider, cancellationToken: cancellationToken);
+        foreach (var diagnostic in plan.Diagnostics)
+            diagnostics.Add(new("SharpPack routed payload graph", diagnostic.GetMessage(InvariantCulture), diagnostic.Location));
+        return new(plan.Source, diagnostics.ToImmutable(), true);
+
+        void AddRoots(bool contractMode)
+        {
+            var state = new DtoAnalysisState(compilation, cancellationToken, contractMode,
+                applyCodecPolicy: true, selectorOnlyContractDefault: false);
+            _ = state.AnalyzeWithFinalCodecBindings();
+            var graph = state.ResolveFinalCodecGraph(includeSerializable: !contractMode, includeContracts: contractMode);
+            foreach (var root in graph.Plans.Values.OfType<FinalAdapterCodecPlan>().Where(IsSharpPackAdapterPlan))
+            {
+                if (state.TryResolveSharpPackReachableType(root.TypeName, out var type))
+                    roots[root.TypeName] = new(type, type.Locations.FirstOrDefault(static loc => loc.IsInSource));
+                else
+                    diagnostics.Add(new(root.TypeName, "The closed routed payload symbol could not be resolved.", Location.None));
+            }
+        }
+    }
+
+    private static string GenerateSharpPackIntegration(SharpPackIntegrationAnalysisResult analysis)
+    {
+        var builder = new StringBuilder(analysis.ProviderSource ?? "// <auto-generated/>\n");
+        builder.AppendLine("""
+            namespace SharpLink.Generated
+            {
+                internal static class __SharpLinkGeneratedSharpPackIntegration
+                {
+                    internal static void Configure(global::SharpLink.Abstractions.IRpcCodecAdapterScope adapterScope)
+                    {
+            """);
+        if (analysis.ProviderSource is { } source)
+        {
+            var identity = Hashing.GetIdentifierHash(source);
+            builder.AppendLine($$"""
+                        if (adapterScope is not global::SharpLink.Serializer.SharpPack.ISharpPackRpcCodecAdapterScopeConfiguration configurable)
+                            throw new global::System.InvalidOperationException("SharpPack adapter scope does not support generated Contract formatter configuration.");
+                        configurable.Configure("slsp/{{identity}}", static builder =>
+                            global::SharpPack.Generated.{{SharedProvider}}.Register(builder));
+                """);
+        }
+        else
+        {
+            builder.AppendLine("            _ = adapterScope;");
+        }
+        return builder.AppendLine("""
+                    }
+                }
+            }
+            """).ToString();
+    }
+
+    private sealed partial class DtoAnalysisState
+    {
+        private FinalCodecGraph ApplySharpPackSidecarCodecIdentities(FinalCodecGraph graph)
+            => graph.Plans.Values.Any(static item => item is FinalAdapterCodecPlan adapter && IsSharpPackAdapterPlan(adapter))
+                ? ApplyRoutedSharpPackSidecarCodecIdentities(graph) : graph;
+
+        [MethodImpl(MethodImplOptions.NoInlining)]
+        private FinalCodecGraph ApplyRoutedSharpPackSidecarCodecIdentities(FinalCodecGraph graph)
+        {
+            var adapterRoots = graph.Plans.Values.OfType<FinalAdapterCodecPlan>().Where(IsSharpPackAdapterPlan)
+                .Select(plan => TryResolveReachableType(plan.TypeName, out var type) ? new SharpPackSidecarRoot(type) : default)
+                .Where(static root => root.Type is not null).ToImmutableArray();
+            if (adapterRoots.IsDefaultOrEmpty) return graph;
+
+            var plan = SharpPackSidecarGenerator.Generate(_compilation, adapterRoots, SharedProvider, cancellationToken: _cancellationToken);
+            Dictionary<string, FinalCodecPlan>? updated = null;
+            foreach (var root in plan.Roots)
+            {
+                if (root.Sidecars.IsDefaultOrEmpty) continue;
+                var typeName = GetTypeName(root.Type);
+                var adapter = (FinalAdapterCodecPlan)graph.Plans[typeName];
+                updated ??= graph.Plans.ToDictionary(static pair => pair.Key, static pair => pair.Value, StringComparer.Ordinal);
+                updated[typeName] = adapter with
+                {
+                    ClosedTargetLogicalIdentity = Hashing.GetSemanticHash("adapter-target/sharppack-sidecar/v1",
+                        adapter.ClosedTargetLogicalIdentity.ToHex(), GetSharpPackSidecarWireIdentity(root.Sidecars).ToHex())
+                };
+            }
+            return updated is null ? graph : new FinalCodecGraph(updated, graph.RootTypes);
+        }
+    }
+
+    private static RpcHashValue GetSharpPackSidecarWireIdentity(ImmutableArray<SharpPackSidecarWireShape> sidecars)
+    {
+        var parts = new List<string> { "sharppack-sidecar-wire/v1" };
+        foreach (var sidecar in sidecars.OrderBy(static shape => GetTypeName(shape.Type), StringComparer.Ordinal))
+        {
+            parts.Add(GetTypeName(sidecar.Type));
+            parts.Add(sidecar.Type.IsValueType ? "value" : "ref");
+            parts.Add(sidecar.Members.Length.ToString(InvariantCulture));
+            foreach (var member in sidecar.Members)
+            {
+                parts.Add(member.Position.ToString(InvariantCulture));
+                parts.Add(member.Name);
+                parts.Add(GetTypeName(member.Type));
+            }
+        }
+        return Hashing.GetSemanticHash(parts.ToArray());
+    }
+}

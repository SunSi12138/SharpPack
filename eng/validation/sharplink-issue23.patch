@@ -0,0 +1,37 @@
+using System;
+
+namespace SharpLink.Generator.Tests;
+
+public partial class RpcAnalyzerTests
+{
+    [Test]
+    public void TupleLabelsDoNotChangeTheSharpPackCodecIdentity()
+    {
+        const string route = """
+            global::System.Threading.Tasks.Task<Vendor.ExternalRequest> EchoAsync(
+                Vendor.ExternalRequest request,
+                global::System.Threading.CancellationToken cancellationToken);
+            """;
+        string Build(string firstLabel, string secondLabel, string assemblyName)
+        {
+            var vendor = CreateSharpPackVendorReference($$"""
+                namespace Vendor;
+                public sealed class Box<T> { public T Value { get; set; } }
+                public sealed class ExternalRequest
+                {
+                    public (int {{firstLabel}}, string Label) Data { get; set; }
+                    public Box<(int {{firstLabel}}, string Value)>? Text { get; set; }
+                    public Box<(int {{secondLabel}}, int Value)>? Number { get; set; }
+                }
+                """);
+            var result = RunSharpPackAndCompile(assemblyName, BuildSharpPackContractSource(route), [vendor]);
+            EnsureNoSharpPackErrors(result);
+            return GetSharpPackCodecHash(result.DriverRunResult, "global::Vendor.ExternalRequest");
+        }
+
+        var first = Build("Alpha", "Zulu", "TupleNamesFirst");
+        var second = Build("Zulu", "Alpha", "TupleNamesSecond");
+        Ensure(string.Equals(first, second, StringComparison.Ordinal),
+            $"Tuple labels cannot change the negotiated codec identity: {first} versus {second}");
+    }
+}

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.6.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/SharpPack.Core/SharpPack.Core.csproj" />
    <ProjectReference Include="../../src/SharpPack.Generator/SharpPack.Generator.csproj" />
    <ProjectReference Include="../../src/SharpPack.Streaming/SharpPack.Streaming.csproj" />
  </ItemGroup>

</Project>

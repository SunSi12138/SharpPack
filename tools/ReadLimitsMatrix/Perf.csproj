<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework>
    <LangVersion>14.0</LangVersion><ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable><AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Optimize>true</Optimize><PublishReadyToRun>false</PublishReadyToRun>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(RepoRoot)/src/SharpPack.Core/SharpPack.Core.csproj" />
    <ProjectReference Include="$(RepoRoot)/src/SharpPack.Streaming/SharpPack.Streaming.csproj" />
    <ProjectReference Include="$(RepoRoot)/src/SharpPack.Generator/SharpPack.Generator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>
</Project>

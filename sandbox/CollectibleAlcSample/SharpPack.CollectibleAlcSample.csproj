<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <DefaultItemExcludes>
      $(DefaultItemExcludes);Plugin/**
    </DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/SharpPack.Core/SharpPack.Core.csproj" />
    <ProjectReference
      Include="Plugin/SharpPack.CollectibleAlcPlugin.csproj"
      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <Target Name="CopyPluginAssembly" AfterTargets="Build">
    <Copy
      SourceFiles="$(MSBuildThisFileDirectory)Plugin/bin/$(Configuration)/net10.0/SharpPack.CollectibleAlcPlugin.dll"
      DestinationFolder="$(OutDir)plugin" />
  </Target>
</Project>

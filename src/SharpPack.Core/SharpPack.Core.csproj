<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
        <RootNamespace>SharpPack</RootNamespace>
        <NoWarn>$(NoWarn);CS1591;CA2255</NoWarn>

        <!-- NuGet -->
        <IsPackable>true</IsPackable>
        <PackageId>SharpPack.Core</PackageId>
        <PackageTags>serializer;binary;zero-copy;memorypack-compatible</PackageTags>
        <Description>SharpPack runtime, serializer APIs, formatter contexts, and built-in formatters.</Description>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="SharpPack.Streaming, " />
    </ItemGroup>

</Project>

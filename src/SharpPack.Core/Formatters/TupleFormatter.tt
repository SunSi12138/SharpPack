<#@ template debug="false" hostspecific="false" language="C#" #>
<#@ assembly name="System.Core" #>
<#@ import namespace="System.Linq" #>
<#@ import namespace="System.Text" #>
<#@ import namespace="System.Collections.Generic" #>
<#@ output extension=".cs" #>
<#
    // T8 = TRest where TRest : notnull
    string TOrRest(int i) => (i == 8) ? "TRest" : $"T{i}";
    string ItemOrRest(int i) => (i == 8) ? $"Rest" : $"Item{i}";
    string CreateT(int i) => string.Join(", ", Enumerable.Range(1, i).Select(x => (x == 8) ? "TRest" : $"T{x}"));
    string CreateTNull(int i) => string.Join(", ", Enumerable.Range(1, i).Select(x => (x == 8) ? "TRest" : $"T{x}?"));
    string HasOverride(int i, string state) => string.Join(
        " || ",
        Enumerable.Range(1, i).Select(x =>
            $"{state}.HasFormatterOverride<{TOrRest(x)}>()"));
    string HasGraphOverride(int i) => string.Join(
        " || ",
        Enumerable.Range(1, i).Select(x =>
            $"graph.HasFormatterOverride<{TOrRest(x)}>()"));
#>
using SharpPack.Internal;

namespace SharpPack.Formatters;

<# for (var i = 1; i <= 8; i++ ) { #>
[Preserve]
public sealed class TupleFormatter<<#= CreateT(i) #>> : SharpPackFormatter<Tuple<<#= CreateTNull(i) #>>>
<# if (i == 8) { #>
    where TRest : notnull
<# } #>
{
    [Preserve]
    public override void Serialize<TBufferWriter>(ref SharpPackWriter<TBufferWriter> writer, scoped ref Tuple<<#= CreateTNull(i) #>>? value)
    {
        if (value == null)
        {
            writer.WriteNullObjectHeader();
            return;
        }

        writer.WriteObjectHeader(<#= i #>);
<# for ( var j = 1; j <= i; j++ ) { #>
        writer.WriteValue(value.<#= ItemOrRest(j) #>);
<# } #>
    }

    [Preserve]
    public override void Deserialize(ref SharpPackReader reader, scoped ref Tuple<<#= CreateTNull(i) #>>? value)
    {
        if (!reader.TryReadObjectHeader(out var count))
        {
            value = null;
            return;
        }

        if (count != <#= i #>) SharpPackSerializationException.ThrowInvalidPropertyCount(<#= i #>, count);

        value = new Tuple<<#= CreateTNull(i) #>>(
<# for ( var j = 1; j <= i; j++ ) { #>
            reader.ReadValue<<#= TOrRest(j) #>>()<#= (j == 8) ? "!" : (j != i) ? "," : "" #>
<# } #>
        );
    }
}

<# } #>

<# for (var i = 1; i <= 8; i++ ) { #>
[Preserve]
public sealed class ValueTupleFormatter<<#= CreateT(i) #>> : SharpPackFormatter<ValueTuple<<#= CreateTNull(i) #>>>
<# if (i == 8) { #>
    where TRest : struct
<# } #>
{
    internal override bool HasFormatterOverrideDependency(FormatterGraph graph)
        => <#= HasGraphOverride(i) #>;

    [Preserve]
    public override void Serialize<TBufferWriter>(ref SharpPackWriter<TBufferWriter> writer, scoped ref ValueTuple<<#= CreateTNull(i) #>> value)
    {
        if (!System.Runtime.CompilerServices.RuntimeHelpers.IsReferenceOrContainsReferences<ValueTuple<<#= CreateTNull(i) #>>>() &&
            !(<#= HasOverride(i, "writer.OptionalState") #>))
        {
            writer.DangerousWriteUnmanaged(value);
            return;
        }

<# for ( var j = 1; j <= i; j++ ) { #>
        writer.WriteValue(value.<#= ItemOrRest(j) #>);
<# } #>
    }

    [Preserve]
    public override void Deserialize(ref SharpPackReader reader, scoped ref ValueTuple<<#= CreateTNull(i) #>> value)
    {
        if (!System.Runtime.CompilerServices.RuntimeHelpers.IsReferenceOrContainsReferences<ValueTuple<<#= CreateTNull(i) #>>>() &&
            !(<#= HasOverride(i, "reader.OptionalState") #>))
        {
            reader.DangerousReadUnmanaged(out value);
            return;
        }

        value = new ValueTuple<<#= CreateTNull(i) #>>(
<# for ( var j = 1; j <= i; j++ ) { #>
            reader.ReadValue<<#= TOrRest(j) #>>()<#= (j == 8) ? "!" : (j != i) ? "," : "" #>
<# } #>
        );
    }
}

<# } #>

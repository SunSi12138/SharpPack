<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <!-- This project is meta package -->
        <IncludeBuildOutput>false</IncludeBuildOutput>
        <IncludeContentInPack>true</IncludeContentInPack>
        <NoWarn>$(NoWarn);NU5128</NoWarn>

        <!-- NuGet -->
        <IsPackable>true</IsPackable>
        <PackageId>SharpPack</PackageId>
        <PackageTags>serializer;binary;zero-copy;source-generator;memorypack-compatible</PackageTags>
        <Description>High-performance, source-generated binary serialization for modern .NET.</Description>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\SharpPack.Core\SharpPack.Core.csproj" />
        <ProjectReference Include="..\SharpPack.Generator\SharpPack.Generator.csproj" />
    </ItemGroup>

</Project>
